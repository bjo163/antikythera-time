{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bjo163.github.io/antikythera-time/schemas/mclock-metrology-suite-v1.schema.json",
  "title": "M-Time M-Clock Metrology Suite Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analysis_tool",
    "identity",
    "method",
    "datasets",
    "suite_summary",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "mtime-mclock-metrology-suite-1"
    },
    "analysis_tool": {
      "type": "object",
      "required": [
        "crate",
        "version",
        "git_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "crate": {
          "const": "mtime-metrology"
        },
        "version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "reference_id",
        "device_id",
        "firmware_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "firmware_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "drift_fit",
        "jitter",
        "offset_spread"
      ],
      "additionalProperties": false,
      "properties": {
        "drift_fit": {
          "type": "string"
        },
        "jitter": {
          "type": "string"
        },
        "offset_spread": {
          "type": "string"
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "label",
          "source_csv",
          "minimum_duration_seconds",
          "samples",
          "elapsed_start_seconds",
          "elapsed_end_seconds",
          "duration_seconds",
          "mean_offset_ns",
          "offset_stddev_ns",
          "jitter_stddev_ns",
          "fit_residual_stddev_ns",
          "max_abs_offset_ns",
          "fitted_intercept_ns",
          "fitted_drift_ppm",
          "temperature_c"
        ]
      }
    },
    "suite_summary": {
      "type": "object",
      "required": [
        "overall_max_abs_offset_ns",
        "overall_max_abs_drift_ppm",
        "temperature_c"
      ]
    },
    "interpretation": {
      "const": "measurement_characterization_only_no_accuracy_class_assigned"
    }
  }
}
